# Application
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# MySQL / PostgreSQL (transactional data via TypeORM)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=clearx
DB_PASSWORD=clearx
DB_DATABASE=clearx
DB_SYNCHRONIZE=false
DB_LOGGING=false

# MongoDB (tenant configuration, raw payloads, audit logs)
MONGO_URI=mongodb://localhost:27017/clearx_config

# Redis (BullMQ - optional, for future background processing)
REDIS_HOST=localhost
REDIS_PORT=6379
